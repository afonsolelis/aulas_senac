# ─────────────────────────────────────────────────────────────────────────────
# Credenciais do Cloudinary
#
# Obtenha em: https://console.cloudinary.com → Settings → API Keys
#
# NUNCA comite o arquivo .env real — ele já está no .gitignore.
# Copie este arquivo para .env e preencha os valores.
# ─────────────────────────────────────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# ─────────────────────────────────────────────────────────────────────────────
# Como subir uma mídia ao Cloudinary e registrar em sources.json
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Instale o SDK (já incluso no devDependencies após npm install):
#      npm install cloudinary
#
# 2. Execute o script de upload:
#      node scripts/upload-to-cloudinary.js <caminho-do-arquivo> <nome-da-chave>
#
#    Exemplo:
#      node scripts/upload-to-cloudinary.js assets/banner-logica.png banner_logica
#
# 3. O script fará o upload e adicionará automaticamente ao sources.json:
#      {
#        "banner_logica": "https://res.cloudinary.com/<cloud>/image/upload/v.../banner-logica.png"
#      }
#
# 4. Use a URL no HTML referenciando sources.json:
#      <!-- Copie a URL do sources.json para o atributo src/href -->
#      <img src="<URL_DO_SOURCES_JSON>" alt="Banner Lógica">
#
# Regras para o nome da chave (sources.json):
#   - snake_case (ex: senac_logo_pb, banner_logica_aula01)
#   - Descritivo: disciplina + tipo + contexto (ex: logica_slide_capa)
#   - Sem espaços, sem caracteres especiais
# ─────────────────────────────────────────────────────────────────────────────
